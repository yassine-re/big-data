CLICKHOUSE_DB=bronze
CLICKHOUSE_USER=eds_admin
CLICKHOUSE_PASSWORD=change_me_for_local_development
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Deux secrets longs, aléatoires et différents. Ne jamais les versionner.
HMAC_PATIENT_SECRET=replace_with_a_long_random_patient_secret --- IGNORE ---
HMAC_STAY_SECRET=replace_with_a_long_random_stay_secret --- IGNORE ---

# Heure quotidienne de lancement du pipeline, en UTC.
PIPELINE_SCHEDULE_TIME_UTC=02:00
PIPELINE_RUN_ON_STARTUP=false
PIPELINE_MAX_RUNS=0
